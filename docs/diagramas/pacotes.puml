@startuml pacotes
!include estilo.iuml
title VaptVupt - Diagrama de Pacotes (Visão Lógica)

package "VaptVupt — projeto Spring Boot único" as APP {

  package "src/main/frontend (React + Vite) — View" as FE {
    package pages {
    }
    package components {
    }
    package contexts {
    }
    package services {
    }
    package utils {
    }
    package assets {
    }
  }

  package "src/main/java — com.vaptvupt" as BE {
    package controller {
    }
    package dto {
    }
    package service {
    }
    package model {
    }
    package repository {
    }
    package config {
    }
    package exception {
    }
  }
}

database "Supabase\n(PostgreSQL)" as DB

pages ..> components
pages ..> contexts
pages ..> services
pages ..> utils
components ..> utils
components ..> contexts
components ..> assets
contexts ..> services

services ..> controller : HTTP / JSON (REST)\ntoken JWT
controller ..> FE : TelasController\nentrega as telas

controller ..> service
controller ..> dto
controller ..> config
service ..> repository
service ..> model
service ..> dto
service ..> exception
service ..> config
dto ..> model
repository ..> model
model ..> exception
config ..> repository
config ..> model
exception ..> dto

repository ..> DB : JPA / Hibernate

note as MVC
  MVC num único projeto:
  View = telas React (src/main/frontend),
  geradas no build e servidas pelo Spring Boot
  Controller = pacote controller
  Model = model + repository + service
end note
@enduml
