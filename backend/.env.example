# Copie este arquivo para "backend/.env" e preencha com os dados do seu projeto no Supabase.
# No Supabase: botão "Connect" > aba "Connection String" > Type "JDBC" > Method "Session pooler".

# URL JDBC do banco, sem usuário e senha (ex.: jdbc:postgresql://HOST:5432/postgres?sslmode=require)
SUPABASE_DB_URL=

# Usuário do pooler (formato postgres.<id-do-projeto>)
SUPABASE_DB_USER=

# Senha do banco no Supabase
SUPABASE_DB_PASSWORD=

# Segredo para assinar os tokens de login (invente um texto com pelo menos 32 caracteres)
JWT_SECRET=
