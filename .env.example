# URL JDBC do banco (sem usuário e senha)
SUPABASE_DB_URL=
# Usuário do pooler (formato postgres.<id-do-projeto>)
SUPABASE_DB_USER=
# Senha definida ao criar o projeto no Supabase
SUPABASE_DB_PASSWORD=
# Segredo usado para assinar os tokens de login (mínimo de 32 caracteres)
JWT_SECRET=jwt-secret-vaptvupt-sistema-aluguel-carros
# Telas: false (padrão) usa a API; true usa dados simulados no navegador, sem banco
VITE_USE_MOCK=false